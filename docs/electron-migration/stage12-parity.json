  "stage13": {
    "status": "cutover_active",
    "default_runtime": "electron",
    "canonical_launcher": "start-electron.ps1",
    "canonical_npm_prefix": "desktop:",
    "tauri_fallback": "legacy_non_blocking",
    "manual_parity_complete": false
  },
  "stage14": {
    "status": "runtime_removed",
    "electron_only": true,
    "removal_authorized_by_owner": true,
    "manual_parity_complete": false,
    "historical_runtime_archive": "docs/archive/legacy"
  },
  "stage15": {
    "status": "release_readiness_active",
    "version_authority": "VERSION",
    "release_static_gate": "npm run release:static",
    "release_candidate_command": "npm run desktop:release-candidate",
    "release_workflow": ".github/workflows/electron-release-readiness.yml",
    "integrity_manifest": "apps/desktop/out/release-manifest.json",
    "auto_publish": false,
    "manual_parity_complete": false
  },
  "stage16": {
    "status": "lifecycle_acceptance_ready",
    "installer": "squirrel.windows",
    "automatic_on_push": false,
    "manual_workflow": ".github/workflows/electron-installer-lifecycle.yml",
    "fresh_install": "implemented",
    "same_version_reinstall": "implemented",
    "upgrade_with_previous_setup": "implemented_optional",
    "uninstall": "implemented",
    "user_data_retention": "implemented",
    "shortcut_lifecycle": "implemented",
    "backend_orphan_check": "implemented",
    "clean_machine_acceptance": "pending_execution"
  },
  "stage17": {
    "status": "signing_update_infrastructure_ready",
    "signing_backend": "pfx_via_windowsSign",
    "signing_required_for_tag_release": true,
    "channels": [
      "stable",
      "beta"
    ],
    "update_transport": "https_static_squirrel_feed",
    "runtime_updater": "electron_autoUpdater",
    "auto_update_default": "disabled",
    "force_restart_on_download": false,
    "signed_release_execution": "pending_credentials",
    "real_cross_version_update": "pending_two_published_versions"
  }
