  "stage13": {
    "status": "cutover_active",
    "default_runtime": "electron",
    "canonical_launcher": "start-electron.ps1",
    "canonical_npm_prefix": "desktop:",
    "tauri_fallback": "legacy_non_blocking",
    "manual_parity_complete": false
  },
  "stage14": {
    "status": "runtime_removed",
    "electron_only": true,
    "removal_authorized_by_owner": true,
    "manual_parity_complete": false,
    "historical_runtime_archive": "docs/archive/legacy"
  },
  "stage15": {
    "status": "release_readiness_active",
    "version_authority": "VERSION",
    "release_static_gate": "npm run release:static",
    "release_candidate_command": "npm run desktop:release-candidate",
    "release_workflow": ".github/workflows/electron-release-readiness.yml",
    "integrity_manifest": "apps/desktop/out/release-manifest.json",
    "auto_publish": false,
    "manual_parity_complete": false
  }
}
