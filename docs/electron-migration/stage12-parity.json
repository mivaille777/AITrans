      "manual": "pending"
    },
    {
      "id": "files_workspace",
      "baseline": "pass",
      "implementation": "implemented",
      "automatic": "contract_regression",
      "manual": "pending"
    },
    {
      "id": "backend_lifecycle",
      "baseline": "pass",
      "implementation": "implemented",
      "automatic": "packaged_lifecycle_smoke",
      "manual": "pending"
    },
    {
      "id": "agent",
      "baseline": "pass",
      "implementation": "preserved",
      "automatic": "regression",
      "manual": "pending"
    },
    {
      "id": "rag",
      "baseline": "pass",
      "implementation": "preserved",
      "automatic": "regression",
      "manual": "pending"
    },
    {
      "id": "sandbox",
      "baseline": "pass",
