{
  "name": "aitrans",
  "productName": "AITrans",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI Agent workspace for research, knowledge, RAG, and multi-agent workflows.",
  "author": "AITrans Contributors",
  "type": "module",
  "scripts": {
    "predev": "npm run sync:pdfjs-assets",
    "dev": "vite",
    "prebuild": "npm run sync:pdfjs-assets",
    "build": "tsc -b && vite build && npm run check:pdfjs-offline && npm run bundle:report",
    "bundle:report": "node scripts/report-bundle.mjs",
    "check:pdfjs-offline": "node scripts/check-pdfjs-offline.mjs",
    "sync:pdfjs-assets": "node scripts/sync-pdfjs-assets.mjs",
    "lint": "oxlint",
    "test": "vitest run && npm run typecheck:test",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "backend:dev": "cd ../.. && python -m backend",
    "backend:package": "node scripts/build-backend-sidecar.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:start": "electron .",
    "test:electron-contracts": "vitest run src/desktop/electron src/desktop/runtime-selection.test.ts && npm run typecheck:test",
    "electron:check": "npm run electron:compile && npm run test:electron-contracts",
    "electron:verify": "npm run electron:check && npm run lint && npm run test && npm run build && node scripts/electron-credential-smoke.mjs",
    "electron:preview": "npm run electron:build && electron .",
    "electron:package": "npm run electron:build && npm run backend:package && electron-forge package --platform=win32 --arch=x64 && node scripts/verify-electron-package.mjs",
    "electron:make": "npm run electron:build && npm run backend:package && electron-forge make --platform=win32 --arch=x64 && node scripts/verify-electron-package.mjs --require-installer",
    "electron:regression": "node scripts/electron-regression.mjs",
    "desktop:dev": "npm run electron:dev",
    "desktop:check": "npm run electron:check",
    "desktop:verify": "npm run electron:verify",
    "desktop:regression": "npm run electron:regression",
    "desktop:build": "npm run electron:build",
    "desktop:preview": "npm run electron:preview",
    "desktop:package": "npm run electron:package",
    "desktop:make": "npm run electron:make",
    "legacy:tauri:dev": "npm run tauri:dev",
    "legacy:tauri:build": "npm run tauri:build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.33.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.4.5",
    "electron-winstaller": "5.4.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "main": "dist-electron/main/index.cjs",
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
